# ==========================================
# The Lenny Growth Assistant - Environment Config
# ==========================================

# Application Runtime Mode: development | test | production
ENVIRONMENT=development

# Database Configuration (PostgreSQL in Docker, SQLite fallback locally)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lenny_growth
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth
# Local Standalone SQLite fallback:
# DATABASE_URL=sqlite+aiosqlite:///./lenny_growth.db

# LLM Providers Configuration
DEFAULT_PROVIDER=ollama

# Local Ollama Settings (Default Working Configuration)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Optional Cloud Providers (Leave blank for 100% offline local Ollama operation)
# When provided, users can toggle runtime provider to Claude or GPT-4o in the UI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# RAG & Grounding Guardrail Thresholds
VECTOR_SIMILARITY_THRESHOLD=0.25
TOP_K_CHUNKS=4

# Frontend URL for CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]
